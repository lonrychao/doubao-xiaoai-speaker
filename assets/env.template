# =====================================================
# 豆包（火山引擎方舟）配置
# 替换占位符后保存为 .env
# =====================================================

# 模型：推理接入点 ID（ep- 开头），或模型 ID
OPENAI_MODEL={{DOUBAO_MODEL}}

# API Key：火山方舟「API Key 管理」里创建的密钥（单个字符串，无需 SK）
OPENAI_API_KEY={{DOUBAO_API_KEY}}

# 火山方舟 OpenAI 兼容接口地址（北京地域，固定值，不要改）
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
